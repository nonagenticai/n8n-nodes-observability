{
  "name": "@nonagenticai/n8n-nodes-observability",
  "version": "0.2.1",
  "description": "n8n node for Prometheus, Loki, Grafana, Pushgateway and OTLP",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "observability",
    "prometheus",
    "loki",
    "grafana"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"helpers/**/*.ts\"",
    "docs": "node generate-docs.js",
    "postbuild": "npm run docs",
    "test": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest",
    "test:coverage": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "replaySafe": true,
    "credentials": [
      "dist/credentials/ObservabilityApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Observability/Observability.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "homepage": "https://nonagentic.ai",
  "dependencies": {
    "axios": "^1.13.2"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "isolated-vm": "7.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.4.1",
    "n8n-workflow": "^1.120.7",
    "orval": "^8.5.3",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "author": {
    "name": "NonAgenticAI",
    "url": "https://nonagentic.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonagenticai/n8n-nodes-observability.git"
  }
}
